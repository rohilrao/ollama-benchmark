import subprocess
import time

import requests
from langchain_deepseek import ChatDeepSeek


# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

VLLM_URL = "http://localhost:8555"
MODEL = "/models/qwen235b"

llm = ChatDeepSeek(
    model=MODEL,
    api_base=f"{VLLM_URL}/v1",
    api_key="EMPTY",
    temperature=0.0,
)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def print_gpu_status(label: str):
    """Print GPU memory usage and utilization via nvidia-smi."""
    print(f"\n{'=' * 70}")
    print(f"GPU STATUS: {label}")
    print("=" * 70)

    result = subprocess.run(
        [
            "nvidia-smi",
            "--query-gpu=index,memory.used,memory.total,utilization.gpu",
            "--format=csv,noheader,nounits",
        ],
        capture_output=True,
        text=True,
        check=True,
    )

    for line in result.stdout.strip().splitlines():
        gpu, used, total, util = [x.strip() for x in line.split(",")]

        print(
            f"GPU {gpu}: "
            f"{int(used):6d} / {int(total):6d} MiB "
            f"({100 * int(used) / int(total):5.1f}%) | "
            f"util={util}%"
        )


def is_sleeping():
    response = requests.get(
        f"{VLLM_URL}/is_sleeping",
        timeout=10,
    )
    response.raise_for_status()

    try:
        return response.json()
    except requests.exceptions.JSONDecodeError:
        return response.text.strip()


def sleep_model(level=1):
    print(f"\nPutting model to sleep (level={level})...")

    start = time.perf_counter()

    response = requests.post(
        f"{VLLM_URL}/sleep",
        params={"level": level},
        timeout=600,
    )
    response.raise_for_status()

    elapsed = time.perf_counter() - start

    print(f"Sleep completed in: {elapsed:.3f} s")
    print(f"is_sleeping: {is_sleeping()}")

    return elapsed


def wake_model():
    print("\nWaking model...")

    start = time.perf_counter()

    response = requests.post(
        f"{VLLM_URL}/wake_up",
        timeout=600,
    )
    response.raise_for_status()

    elapsed = time.perf_counter() - start

    print(f"Wake completed in: {elapsed:.3f} s")
    print(f"is_sleeping: {is_sleeping()}")

    return elapsed


def run_inference(prompt):
    print("\nRunning inference...")

    start = time.perf_counter()

    response = llm.invoke(prompt)

    elapsed = time.perf_counter() - start

    print(f"Inference completed in: {elapsed:.3f} s")
    print(f"Response: {response.content[:300]}")

    return elapsed


# ---------------------------------------------------------------------------
# Test
# ---------------------------------------------------------------------------

def main():

    print("\nINITIAL STATE")
    print(f"is_sleeping: {is_sleeping()}")

    print_gpu_status("Before inference")

    # 1. Warm inference
    inference_before = run_inference(
        "What is the capital of Germany? Answer in one sentence."
    )

    print_gpu_status("After inference")


    # 2. Sleep
    sleep_time = sleep_model(level=1)

    # Give nvidia-smi a moment to reflect released allocations
    time.sleep(2)

    print_gpu_status("After sleep")


    # 3. Wake
    wake_time = wake_model()

    time.sleep(2)

    print_gpu_status("After wake")


    # 4. Verify inference still works
    inference_after = run_inference(
        "What is the capital of France? Answer in one sentence."
    )

    print_gpu_status("After post-wake inference")


    # -----------------------------------------------------------------------
    # Summary
    # -----------------------------------------------------------------------

    print("\n" + "=" * 70)
    print("RESULTS")
    print("=" * 70)

    print(f"Sleep time:               {sleep_time:.3f} s")
    print(f"Wake time:                {wake_time:.3f} s")
    print(f"Inference before sleep:   {inference_before:.3f} s")
    print(f"Inference after wake:     {inference_after:.3f} s")


if __name__ == "__main__":
    main()
