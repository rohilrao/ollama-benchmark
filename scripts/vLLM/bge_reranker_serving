  import requests


BASE_URL = "http://localhost:8557"
MODEL = "bge-reranker-v2-m3"

query = (
    "Welche Unterlagen sind für den Abbau "
    "kerntechnischer Anlagen erforderlich?"
)

documents = [
    "Der Antragsteller muss die erforderlichen Unterlagen einreichen.",
    "Die Anlage befindet sich seit 2019 im sicheren Einschluss.",
    "Für den Abbau sind Sicherheitsberichte und "
    "Strahlenschutzunterlagen vorzulegen.",
]


def test_endpoint(endpoint, payload):
    try:
        response = requests.post(
            f"{BASE_URL}{endpoint}",
            json=payload,
            timeout=60,
        )
        response.raise_for_status()

        print(f"{endpoint}: works")
        print(response.json())

    except requests.RequestException as error:
        print(f"{endpoint}: does not work")
        print(error)

        if error.response is not None:
            print(error.response.text)


test_endpoint(
    "/v1/score",
    {
        "model": MODEL,
        "queries": query,
        "documents": documents,
    },
)

test_endpoint(
    "/v1/rerank",
    {
        "model": MODEL,
        "query": query,
        "documents": documents,
        "top_n": len(documents),
    },
)
